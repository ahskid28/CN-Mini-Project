{
  "listen_host": "127.0.0.1",
  "listen_port": 8888,
  "workers": 32,
  "timeout": 10,
  "cache_ttl": 30,
  "cache_max_bytes": 16777216,
  "max_response_bytes": 8388608,
  "blocked_domains": ["blocked.example"],
  "rate_limit": 120,
  "rate_window": 60,
  "log_file": "logs/traffic.jsonl",
  "allow_private_destinations": true
}
